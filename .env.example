# ---- Üzemmód ----
# true  = minden külső hívás csak naplózódik (data/dryrun.jsonl), álazonosítót ad vissza
# false = éles hívások
DRY_RUN=true
PORT=3000
# A konfigurátor oldal origin-je (CORS). Vesszővel több is adható.
ALLOWED_ORIGINS=http://localhost:3000,https://ajanlat.excellence.hu
# Az ajánlat publikus címe (linkekhez e-mailben / PDF-ben)
PUBLIC_URL=https://ajanlat.excellence.hu

# ---- bevetel.hu CRM ----
BEVETEL_BASE_URL=https://excellence.bevetel.hu
BEVETEL_API_KEY=
# A saját CRM-felhasználóm azonosítója (lead tulajdonos -> jutalék)
BEVETEL_USER_ID=
# Publikus marketing csatorna (Facebook) specId – kulcs nélküli lead beküldéshez
BEVETEL_CHANNEL_SPEC_ID=
# Visszahívás foglaláshoz
BEVETEL_BOOKING_SERVICE_ID=
BEVETEL_BOOKING_RESOURCE_ID=

# ---- Számlázz.hu (díjbekérő) ----
SZAMLAZZ_AGENT_KEY=
SZAMLAZZ_BANK=
SZAMLAZZ_BANK_ACCOUNT=
SZAMLAZZ_INVOICE_PREFIX=EXC

# ---- E-mail (Resend vagy Brevo; üresen = dry) ----
MAIL_PROVIDER=resend
MAIL_API_KEY=
MAIL_FROM="Gulyás Szabolcs – Excellence <gulyas.szabolcs@excellence.hu>"
MAIL_REPLY_TO=gulyas.szabolcs@excellence.hu
# Belső értesítés (új ajánlat, egyedi árkérés, kérdés)
NOTIFY_TO=gulyas.szabolcs@excellence.hu

# ---- NAV Online Számla (adószám -> cégnév) ----
NAV_LOGIN=
NAV_PASSWORD=
NAV_SIGN_KEY=
NAV_EXCHANGE_KEY=
NAV_TAX_NUMBER=

# ---- Facebook Lead Ads webhook ----
FB_VERIFY_TOKEN=valami-titkos-szo
FB_PAGE_TOKEN=

# --- Admin felület (/admin) – lásd docs/admin-spec.md ---
# Belépés e-mailes linkkel; vesszővel elválasztott címek
ADMIN_OWNERS=gulyas.szabolcs@excellence.hu,gulyas.szabolcs.laszlo@gmail.com
ADMIN_PARTNERS=
# Pilot: az első N rendelést az Excellence hagyja jóvá (0 = kikapcsolva)
PILOT_ORDERS=20
# Jutalék (kódban rögzítve): 5 000–500 000 Ft 15%, 500 001–2 000 000 Ft 17%, 2 000 000 Ft felett 20%; sales zárásnál a fele
# Félbehagyás: ennyi perc mozgás nélkül (alap 120), emlékeztető ennyi perccel utána (alap 1320 = 22 óra)
ABANDON_MIN=120
ABANDON_MAIL_MIN=1320
# Meta Pixel azonosító (csak marketing-hozzájárulással töltődik be)
META_PIXEL_ID=
# Száraz módban: /admin?key=<ez> címen a belépőlink a képernyőn jelenik meg (amíg nincs levelezés)
ADMIN_DEV_KEY=
